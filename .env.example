# ==============================================================================
# LZT Terminal Trader — Конфигурационный файл (.env)
# ==============================================================================

# --- Режим работы (Operating Mode) ---
# simulation : Безопасная песочница без реальных трат (рекомендуется для тестов)
# live       : Подключение к реальному API lzt.market с реальным балансом
APP_MODE=simulation
SIMULATION_MODE=true
LIVE_PURCHASE_ENABLED=false

# Требовать подтверждение оператора перед совершением покупки (true / false)
MANUAL_PURCHASE_CONFIRMATION=true
MANUAL_RESALE_CONFIRMATION=false

# --- Доступ к LZT Market API ---
# Токен можно получить в профиле LZT: Настройки -> Доступ к API
# Если оставить пустым, программа автоматически переключится в SIMULATION MODE
LZT_API_TOKEN=
LZT_API_KEY=
LZT_API_BASE_URL=https://api.lzt.market
LZT_REQUEST_TIMEOUT=15.0
LZT_RATE_LIMIT_RPS=3.0

# --- Финансовые лимиты и безопасность (Все суммы в RUB) ---
# Максимальный дневной бюджет (при превышении покупки блокируются)
MAX_DAILY_BUDGET=3000.0
# Максимальная цена покупки за один аккаунт
MAX_PURCHASE_PRICE=350.0
# Минимальная чистая прибыль для одобрения сделки
MIN_NET_PROFIT=50.0
# Минимальный процент ROI (рентабельности)
MIN_ROI_PERCENT=25.0
# Максимальное количество покупок в сутки
MAX_ACTIVE_PURCHASES_PER_DAY=10

# Комиссии маркета
BUY_FEE_PERCENT=2.0
RESALE_FEE_PERCENT=4.0

# --- Анализ описаний лотов (AI / Heuristic) ---
# local     : Бесплатный встроенный эвристический анализатор и защита от инъекций (рекомендуется)
# openai    : Анализ через OpenAI API (требует LLM_API_KEY)
# gemini    : Анализ через Google Gemini API (требует LLM_API_KEY)
# anthropic : Анализ через Anthropic Claude API (требует LLM_API_KEY)
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- База данных и логи ---
DATABASE_PATH=data/trader.db
DATABASE_URL=sqlite+aiosqlite:///lzt_arbitrage.db
LOGS_PATH=logs/trader.log
LOG_LEVEL=INFO
