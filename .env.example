# ==============================================================================
# LZT Market AI Multi-Agent Arbitrage System Configuration
# ==============================================================================

# --- Operating Mode & Safety Controls ---
SIMULATION_MODE=true
LIVE_PURCHASE_ENABLED=false
MANUAL_PURCHASE_CONFIRMATION=true
MANUAL_RESALE_CONFIRMATION=true

# --- LZT Market API Credentials ---
# Leave empty to run with realistic simulated LZT market data
LZT_API_KEY=
LZT_API_BASE_URL=https://api.lzt.market
LZT_REQUEST_TIMEOUT=15.0
LZT_RATE_LIMIT_RPS=3.0

# --- Telegram Admin Bot Integration ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Financial Thresholds & Limits (All in RUB / Target Currency) ---
MIN_NET_PROFIT=50.0
MIN_ROI_PERCENT=25.0
MAX_PURCHASE_PRICE=300.0
MAX_DAILY_BUDGET=3000.0
MAX_ACTIVE_PURCHASES_PER_DAY=10
MIN_CONFIDENCE_SCORE=0.70

# --- Market Fees ---
BUY_FEE_PERCENT=2.0
RESALE_FEE_PERCENT=4.0

# --- Pluggable LLM Configuration ---
# Options: mock, openai, anthropic, gemini
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- System & Storage Settings ---
DATABASE_URL=sqlite+aiosqlite:///lzt_arbitrage.db
LOG_LEVEL=INFO
SCAN_INTERVAL_SECONDS=30
SYSTEM_HEALTH_CHECK_INTERVAL=60
